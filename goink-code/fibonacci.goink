fun generateFibonacci(limit) {
    var a = 0;
    var b = 1;

    print "Starting sequence...";

    for (var i = 0; i < limit; i = i + 1) {
        print a;

        // Block-scoped variable: created and destroyed 15 times!
        var temp = a;
        a = b;
        b = temp + b;
    }

    print "Sequence complete.";
}

print "--- Generating First 15 Fibonacci Numbers ---";
generateFibonacci(15);
